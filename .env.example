APP_NAME="Todo Sycn"
APP_ENV=production
APP_KEY=base64:gJcANmq1AogbI+cj/+R9aKM5mfIyZb1z2bY9gG8UDtQ=
APP_DEBUG=false
APP_URL=https://todosync.diogo.com

APP_LOCALE=pt_PT
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_PT

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
